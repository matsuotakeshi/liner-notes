#!/bin/sh
set -e
case "$1" in
  configure)
    getent group liner_notes_linkctl >/dev/null ||
      addgroup --quiet --system liner_notes_linkctl
    getent passwd liner_notes_link >/dev/null ||
      adduser --quiet --system --disabled-login --no-create-home \
        --home /var/lib/liner-notes-link --ingroup liner_notes_linkctl liner_notes_link
    install -d -m 0700 -o liner_notes_link -g liner_notes_linkctl /var/lib/liner-notes-link
    if [ -f /etc/liner-notes/link.toml ]; then
      chgrp liner_notes_linkctl /etc/liner-notes/link.toml
      chmod 0640 /etc/liner-notes/link.toml
    fi
    ;;
esac
#DEBHELPER#
exit 0
