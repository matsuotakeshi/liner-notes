MESSAGE(CHAT_PROMPT, "チャット> ")
MESSAGE(CHAT_ENTER, "チャット室：W で参加者、// で退出します。\r\n直近の会話（全員退出すると消去）：\r\n")
MESSAGE(CHAT_EXIT, "チャットを終了しました。\r\n")
MESSAGE(CHAT_JOIN, "\r\n* %s (%s) さんが入室しました。\r\n")
MESSAGE(CHAT_LEAVE, "\r\n* %s (%s) さんが退出しました。\r\n")
MESSAGE(CHAT_WHO, "\r\n  #%lu  %s (%s)\r\n")
MESSAGE(CHAT_SAY, "\r\n[%s (%s)] %s\r\n")
MESSAGE(CHAT_END, "参加者一覧は以上です。\r\n")
MESSAGE(CHAT_INVALID, "制御文字を含まないUTF-8で、1〜512バイトの文を入力してください。\r\n")
MESSAGE(CHAT_COMMAND, "不明なチャット操作です。? でヘルプ、/SAY 本文 で操作文字を発言できます。\r\n")
MESSAGE(CHAT_RATE, "発言の間隔を0.5秒以上あけてください。\r\n")
MESSAGE(CHAT_FULL, "チャット室を利用できません。\r\n")
MESSAGE(HELP_CHAT, "チャット室（利用停止されていない会員専用）\r\nCHAT で共通の部屋に入ります。文を入力してEnterで発言します。\r\nW または /WHO：室外も含む接続者、? または /HELP：このヘルプ。\r\n// または /LEAVE：掲示板へ戻る。/QUIT：接続を終了。\r\n/LANG ja または /LANG en：表示言語の切替。\r\n/SAY 本文：W、?、//、/で始まる文をそのまま発言。\r\n1行512バイト以内のUTF-8。発言間隔は0.5秒以上。\r\n入室時に直近20件を表示します。--chat-log で共通チャットを保存できます。個別トークは保存しません。\r\n全員退出または終了で入室時のメモリ内履歴は消去しますが、保存ログは残ります。\r\n入室時のハンドルと、本人を識別するログイン名を表示します。\r\nT または /TALK で相手の接続番号を入力。T 番号・/TALK 番号でも指定できます。\r\n/REPLY で直近の私信の相手へ。私信は共通履歴に残りません。\r\n個別トーク中の //・/END は共通チャットへ戻る操作です。/LEAVE は退出します。\r\n相手不在時は送信を止めます。戻るか再指定してください。/SAY も個別送信です。\r\n相手はログイン済みの会員接続から選べます。DでSYSOPを呼び出せます。\r\n /TALK OFF|ON: 個別受信の停止・再開。/MUTE ログイン名: 相手の私信と共通発言を非表示。/UNMUTE ログイン名: 解除。/MUTES: 一覧。設定は自動保存し、同じ会員の別接続にも反映します。入退室は表示します。\r\nBBS画面から TALK [接続番号] で室外トーク、ONLINEでログイン済み接続一覧、/REPLYで返信。//で元の画面へ。入力・転送中などの相手には送れません。\r\nBBS画面のMEMO [一言]で接続者メモ（省略で消去）。ONLINEで閲覧。CALL [用件]で管理者へ通知、30秒間隔。チャット停止時は利用不可。\r\n旧補助キー: D=SYSOP呼出、#=接続状態、\\=接続者メモ入力（``も可）。\r\n\r\nWは室外も含む全接続者。#は現在時刻・接続秒数・接続人数・本人の利用集計。T [番号]は一言送信後に元のチャットへ戻ります。継続した個別会話は/TALK [番号]、BBS画面ではTALK [番号]。\\で接続者メモを入力。\r\n")
MESSAGE(TALK_SELECT, "相手の接続番号（Wで参加者一覧、//で中止）> ")
MESSAGE(TALK_BLOCKED, "個別トーク送信不可（//で共通チャットへ）> ")
MESSAGE(TALK_PROMPT, "個別 #%lu> ")
MESSAGE(TALK_IN, "\r\n[私信 受信 #%lu %s (%s)] %s\r\n")
MESSAGE(TALK_OUT, "\r\n[私信 送信 #%lu %s (%s)] %s\r\n")
MESSAGE(TALK_OPEN, "接続 #%lu への個別トークです。入力は相手だけに送信します。//で共通チャットへ戻ります。\r\n")
MESSAGE(TALK_END, "個別トークを終了しました。以後の入力は共通チャットへ送信します。\r\n")
MESSAGE(TALK_GONE, "個別トークの相手を利用できません。共通チャットには送信していません。//で戻るか相手を選び直してください。\r\n")
MESSAGE(TALK_INVALID, "Wの参加者一覧にある、自分以外の接続番号を指定してください。\r\n")
MESSAGE(TALK_RECEIVE, "個別トーク受信: %s（会員ごとに自動保存）\r\n")
MESSAGE(TALK_MUTED, "  ミュート: %s\r\n")
MESSAGE(TALK_MUTE_ERROR, "登録済みの別会員のログイン名を指定してください（最大32人）。\r\n")
MESSAGE(TALK_REFUSED, "相手の受信設定により個別送信できません。送信しませんでした。\r\n")
MESSAGE(CHAT_KICKED, "管理者の操作でチャットから退出しました。この接続を終了します。\r\n")
MESSAGE(CHAT_KICK_DONE, "%s のチャット退出: %u 接続を終了しました。\r\n")
MESSAGE(AUDIT_CHAT_KICK, "チャット退出指示")
MESSAGE(ERR_CHAT_MEMBER, "登録済みの会員が見つかりません。\r\n")
MESSAGE(TALK_OUTSIDE_END, "個別トークを終了しました。元の画面へ戻ります。\r\n")
MESSAGE(MAIL_PROMPT, "MAIL (L一覧/N新着日付/T最新から/E送信/R返信/K削除/番号/+/0終了)> ")
MESSAGE(MAIL_TO_PROMPT, "宛先ログイン名 (/CANCEL 中止)> ")
MESSAGE(MAIL_TITLE_PROMPT, "メール題名 (/CANCEL 中止)> ")
MESSAGE(MAIL_CONFIRM, "両者の一覧から削除します。よろしいですか (Y/N)> ")
MESSAGE(MAIL_CLOSED, "メールを終了しました。\r\n")
MESSAGE(MAIL_STORAGE, "メール保存領域に異常があります。処理を確定できません。\r\n")
MESSAGE(MAIL_UNAVAILABLE, "メールまたは宛先を利用できません。権限・容量・入力を確認してください。\r\n")
MESSAGE(MAIL_EDIT, "メール本文を入力してください。単独の . で送信、/SAVEで下書き保存、/CANCELで中止。\r\n")
MESSAGE(MAIL_LIST, "メール一覧（未読 %u 通、既読欄: 0未読/1既読）\r\n")
MESSAGE(MAIL_ROW, "  %u  %s → %s  既読:%u  %s\r\n")
MESSAGE(MAIL_END, "続き位置: %u（0なら終わり、+で続き）\r\n")
MESSAGE(MAIL_ITEM, "メール %u  差出人:%s 宛先:%s 既読:%u 返信元:%u\r\n題名: %s\r\n%sメール終わり\r\n")
MESSAGE(MAIL_SENT, "メール %u を保存し、送信しました。\r\n")
MESSAGE(MAIL_DELETED, "メール %u を削除しました。\r\n")
MESSAGE(MAIL_NOTICE, "未読メール: %u 通。MAILで確認できます。\r\n")
MESSAGE(HELP_MAIL, "会員間メール\r\nMAILで入ります。L一覧、N新着日付、T最新から連続読み、番号で読む、+続き。\r\nEで宛先・題名を入力し本文作成。R 番号で受信メールへ返信。\r\nK 番号で削除確認。送信者・受信者のいずれも両者から削除できます。\r\n0で終了。MAIL SEND ログイン名 題名 / MAIL READ 番号 / MAIL REPLY 番号 / MAIL DELETE 番号も使用可能。\r\nMAIL SENT / MAIL INBOX / MAIL UNREAD で絞り込み。読むと受信者のみ既読になります。\r\n本文は . で送信、/CANCELで中止。/PREVIEW・行編集に対応。/SAVEで下書きを保存できます。\r\n /SAVEで下書き保存・終了。MAIL DRAFTで版番号を確認、MAIL RESUMEで再開、MAIL DRAFT DELETE 版番号で削除。\r\nMAIL NOTIFYで確認、MAIL NOTIFY ON / OFFで新着通知を切り替えます。\r\nMAIL SEARCH 語句で題名・本文を検索。+で続き。本人の送受信メールのみ、大小文字を区別します。\r\nメール添付: ZMAILUPLOAD [説明]で非公開ファイルを送信、MAIL FILESで本人のファイル一覧。メール編集中に /ATTACH 番号 または /DETACH、/SAVEで保存または送信。ZMAILDOWNLOAD 番号で取得。MAIL DROP 番号 CONFIRMで未使用ファイルを回収。1通最大16ファイル、各1GiBまで。送受信者のみ取得可能（SYSOPの例外なし）。\r\nZMAILRESUME 元の説明: 中断した添付アップロードを再開。同じ元ファイルを選択。\r\nMAIL NEWS YYYY-MM-DD: 指定日以降の受信メール（既読も含む、設定タイムゾーン）。+で続き。SYSOPMAIL 題名: ゲストからもSYSOPへ送信（管理者ID最小の有効会員宛）。\r\n\r\n/ATTACH 番号を繰り返して最大16ファイルを添付できます。同じ番号の重複は無視します。/DETACH 番号で1件、/DETACHで全件を外します。下書き保存・再開にも対応。添付は送信者と受信者だけが閲覧でき、最後のメール・下書き参照を削除すると容量を回収します。\r\n\r\nMAIL SCAN ASC / MAIL SCAN DESC: 連続読み出し。Enter/CONTINUE、+/-、+N/-N、STOPを使用できます。\r\nMAIL GET [メール番号] / G: 閲覧可能な本文を共通編集バッファへ取り込みます。次の編集で /BUFFER を使います。\r\nZMAILDOWNLOADALL メール番号: そのメールの添付最大16件を一括取得（ZMODEM、合計16GiBまで）。同名は番号を前置して区別します。送受信者限定でSYSOPの例外はありません。\r\nCHECK MAIL: 主メニューから前回確認日時による巡回。\r\n\r\nMAIL SCAN中のF: 無停止連続表示。入力で停止。\r\nZMAILUPLOADBATCH 説明: 最大16個の添付用ファイルを一括受信。MAILFILESで番号確認、/ATTACH 番号で添付。\r\nZMAILRESUMEBATCH 説明: 同じ説明・ファイル集合で一括受信を再開。\r\n\r\nNは日付入力（空入力はCHECK MAIL）。次の未読はMAIL NEXT、最新1通はMAIL LATESTです。\r\n\r\n通常の本文表示中もEnter:次、P:前、L:再表示、F:次から無停止、+/-や+N/-N:方向・相対移動。MAIL LISTで一覧へ戻ります。Gは共通バッファへ取り込み、次の編集で/BUFFERを使用。\r\nMAILUPLOAD / MAILUPLOADBATCH / MAILDOWNLOAD / MAILDOWNLOADALLはPROTOCOLで選んだ方式を使用。UPLOAD側の引数は説明（XMODEM/TEXTは名前|サイズ|説明）、DOWNLOAD側はファイル番号／メール番号。Zで始まる従来コマンドはZMODEM固定。XMODEM/TEXTの一括転送は不可。送受信者限定は全方式共通。\r\n")
MESSAGE(MAIL_DRAFT_INFO, "メール下書き %u 宛先:%s 返信元:%u 題名:%s\r\n")
