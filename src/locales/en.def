MESSAGE(ERR_EXTRAS, "The changes journal is unavailable. Administrator review is required.")
MESSAGE(ERR_FIND, "Use FIND HERE|ALL author-login|* keyword|*. Specify an existing author login.")
MESSAGE(ERR_EXTENDED, "Invalid command syntax. See HELP CONTENT / HELP PROFILE.")
MESSAGE(ERR_PROFILE, "Profile unavailable.")
MESSAGE(ERR_PROFILE_TEXT, "Handle: 80 bytes; bio: 320 bytes; query: 80 bytes. Control characters are not allowed.")
MESSAGE(WITHDRAW_CONFIRM, "To withdraw article #%u, enter WITHDRAW %u CONFIRM. The content will no longer be public; reply links remain.\r\n")
MESSAGE(WITHDRAW_SAVED, "Article #%u withdrawn.\r\n")
MESSAGE(RETITLED, "Article #%u retitled.\r\n")
MESSAGE(WITHDRAWN, "#%u (parent #%u): withdrawn by the author.\r\n")
MESSAGE(FIND, "Search scope/author/query: %s\r\n")
MESSAGE(FIND_ROW, "%u  [board %u / parent %u] %s\r\n")
MESSAGE(SCAN_HINT, "Sequential reading: Enter for the next article; STOP or Q to stop. Articles are not marked read.\r\n")
MESSAGE(SCAN_STOP, "Sequential reading stopped.\r\n")
MESSAGE(SCAN_END, "End of matching articles.\r\n")
MESSAGE(INFO, "Board %u: %s\r\nInformation: %.*s\r\n")
MESSAGE(PROFILE, "Member %u: %s\r\nHandle: %.*s\r\nBio: %.*s\r\n")
MESSAGE(PROFILE_SAVED, "Profile saved.\r\n")
MESSAGE(PROFILES, "Profile search: %s\r\n")
MESSAGE(PROFILE_ROW, "%u  %s  %s\r\n")
MESSAGE(HELP_CONTENT, "Published articles, cross-board search and sequential reading\r\nWITHDRAW id asks for confirmation; WITHDRAW id CONFIRM withdraws your article.\r\nWithdrawal cannot be undone. IDs/replies remain; historical source bytes remain in storage.\r\nRETITLE id title lets the author or admin rename an article in the current board.\r\nFIND HERE|ALL author-login|* keyword|* searches the current/all readable boards.\r\nExamples: FIND ALL alice * / FIND ALL * FreeBSD / FIND HERE alice setup\r\n+ fetches more results; a result number switches boards and reads the article.\r\nSCAN HERE|ALL author-login|* keyword|* reads matching articles sequentially.\r\nEnter or CONTINUE advances; STOP/Q stops. Reading does not mark articles read.\r\nPAGER ON/OFF controls screens inside each article. Q during paging also stops the sequence.\r\nINFO [board-id] displays board information.\r\n")
MESSAGE(HELP_PROFILE, "Public profiles (for logged-in members)\r\nPROFILE shows yours; PROFILE login shows another member's public profile.\r\nHANDLE display-name saves a handle (80 bytes). HANDLE alone clears it.\r\nBIO introduction saves a single-line bio (320 bytes). BIO alone clears it.\r\nPROFILES [query] searches login, handle and bio; omit query to list all.\r\n+ fetches more; select a number for a profile. Suspended accounts are excluded.\r\nHandles may repeat and do not change login names or article authorship.\r\nEnter only information you want members to see. Historical values remain in the journal.\r\nLOCATION / OCCUPATION / INTERESTS / WEBSITE / CONTACT text: additional public fields, 320 bytes each; omit text to clear. Visibility is controlled by PROFILEVIS; search respects visibility.\r\nPROFILESET field text; PROFILEVIS field PRIVATE|MEMBERS|MONTHDAY (birthday only); PROFILEFIND field query. Fields: HANDLE BIO LOCATION OCCUPATION INTERESTS WEBSITE CONTACT MACHINE BIRTHDAY REALNAME KANA ADDRESS PHONE. Birthday: YYYY-MM-DD. HANDLE remains public to members. BIOEDIT edits up to 8192 bytes. New personal fields default to private. PROFILEFIND GROUP 1..100 searches group membership.\r\n\r\nProfile screen E asks field number then value; administrators first choose a member ID (Enter selects self). S asks field and condition, then displays each matching member's visible details.\r\nOnly with --rtbbs-member-policy: address/birthday self-edits require an administrator; GROUP search requires SIGOP/admin; real name/kana/address/phone field searches require admin. Existing visibility is preserved; private fields are not exposed to other members.\r\n")
