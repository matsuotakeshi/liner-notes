[Unit]
Description=Liner notes bulletin board system
After=network.target

[Service]
Type=simple
User=liner_notes
Group=liner_notes
WorkingDirectory=/var/lib/liner-notes
StateDirectory=liner-notes
StateDirectoryMode=0700
LogsDirectory=liner-notes
LogsDirectoryMode=0700
EnvironmentFile=/etc/liner-notes/liner-notes.env
ExecStart=@PREFIX@/sbin/liner-notes $LINER_NOTES_OPTIONS
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/liner-notes /var/log/liner-notes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
