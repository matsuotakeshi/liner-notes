<?xml version='1.0'?>
<!DOCTYPE service_bundle SYSTEM '/usr/share/lib/xml/dtd/service_bundle.dtd.1'>
<service_bundle type='manifest' name='liner-notes'>
  <service name='application/liner-notes' type='service' version='1'>
    <create_default_instance enabled='false'/>
    <single_instance/>
    <dependency name='filesystem' grouping='require_all' restart_on='none' type='service'>
      <service_fmri value='svc:/system/filesystem/local:default'/>
    </dependency>
    <dependency name='network' grouping='require_all' restart_on='none' type='service'>
      <service_fmri value='svc:/milestone/network:default'/>
    </dependency>
    <method_context working_directory='/var/opt/liner-notes'>
      <method_credential user='liner_notes' group='liner_notes' privileges='basic' limit_privileges='basic'/>
    </method_context>
    <exec_method type='method' name='start'
                 exec='@PREFIX@/libexec/liner-notes-smf start /etc/liner-notes/solaris.json'
                 timeout_seconds='60'/>
    <exec_method type='method' name='stop' exec=':kill' timeout_seconds='60'/>
    <property_group name='startd' type='framework'>
      <propval name='duration' type='astring' value='contract'/>
    </property_group>
    <template>
      <common_name><loctext xml:lang='C'>Liner Notes BBS</loctext></common_name>
    </template>
  </service>
</service_bundle>
